# Copiar este archivo como .env (no se sube al repositorio) y completar.
# Si una variable queda vacía, la aplicación usa la versión simulada.

# Mercado Pago (Checkout Pro). Access Token de prueba (TEST-...) desde
# https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=
# Dirección a la que Mercado Pago vuelve al terminar el pago.
URL_PUBLICA=http://127.0.0.1:8000/

# Mail de confirmación por SMTP con STARTTLS (por ejemplo Gmail con una
# contraseña de aplicación: smtp.gmail.com, puerto 587).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=EcoHarmony Park <tu-cuenta@gmail.com>

# Emails que pueden comprar (sesión simulada, FAQ 19), separados por coma.
USUARIOS_REGISTRADOS=visitante@ecoharmony.com
